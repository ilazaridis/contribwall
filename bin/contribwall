#!/bin/sh
# contribwall -- your GitHub contributions, full screen.
set -eu

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/contribwall"
PROFILE="$DATA/browser-profile"
AGENTS="$HOME/Library/LaunchAgents"
AGENT_SERVER="com.github.contribwall.server"
AGENT_AWAKE="com.github.contribwall.awake"
TAB=$(printf '\t')

usage() {
    cat <<'USAGE'
contribwall -- your GitHub contributions, full screen.

  contribwall                 put it on screen
  contribwall off             take it off
  contribwall displays        list the screens it can use
  contribwall display         choose a screen
  contribwall display <name>  choose it by name, or "auto"
  contribwall range <r>       week | 14 | month | 1-90
  contribwall ramp <r>        darker | brighter  (which end is a busy day)
  contribwall awake on|off    stop the screens sleeping
  contribwall status          what is running, and what it is showing

Settings live in ~/.config/contribwall/config.json.
USAGE
}

# Settings go through the server's own validation, so the two never disagree.
cfg()     { python3 "$DATA/server.py" --get "$1"; }
cfg_set() { python3 "$DATA/server.py" --set "$1" "$2"; }

# pkill matches a regex, so a path with dots would match more than it should.
ere_quote() {
    python3 -c 'import sys
print("".join("\\" + c if c in ".[]()*+?{}|^$\\" else c for c in sys.argv[1]))' "$1"
}

# No leading dashes: pgrep/pkill would read them as options.
browser_pattern() { ere_quote "user-data-dir=$PROFILE"; }

stop_window() {
    pkill -f "$(browser_pattern)" 2>/dev/null || true
}

find_browser() {
    for name in "Google Chrome" "Brave Browser" "Microsoft Edge" "Chromium"; do
        if [ -d "/Applications/$name.app" ]; then
            echo "$name"
            return 0
        fi
    done
    return 1
}

# Tell our own server apart from anything else holding the port.
server_ok() {
    curl -fsS --max-time 5 "http://127.0.0.1:$1/health" 2>/dev/null | grep -q contribwall
}

list_displays() { osascript -l JavaScript "$DATA/pick-display.js" --list "${1:-}"; }

# Two monitors can share a name, so remember which match was meant.
qualify() {
    name="$1"
    position="$2"
    total=$(list_displays | cut -f2 | grep -Fxc -- "$name" 2>/dev/null || true)
    if [ "${total:-1}" -gt 1 ]; then
        nth=$(list_displays | cut -f2 | sed -n "1,${position}p" | grep -Fxc -- "$name" 2>/dev/null || true)
        printf '%s#%s' "$name" "${nth:-1}"
    else
        printf '%s' "$name"
    fi
}

show_displays() {
    current=$(cfg display)
    printf '\n'
    list_displays "$current" | while IFS="$TAB" read -r index name size main chosen; do
        if [ "$chosen" = "*" ]; then
            marker=" *"
        else
            marker="  "
        fi
        printf '%s %s) %-26s %-11s %s\n' "$marker" "$index" "$name" "$size" "$main"
    done
    printf '\n'
    if [ -z "$current" ]; then
        printf '  Using: auto (the second screen, if there is one)\n\n'
    fi
}

case "${1:-open}" in
    -h|--help|help)
        usage
        exit 0
        ;;

    off)
        stop_window
        exit 0
        ;;

    displays)
        show_displays
        exit 0
        ;;

    display)
        if [ "${2:-}" = "auto" ]; then
            cfg_set display ""
            echo "Display: auto (the second screen, if there is one)"
            echo "Run 'contribwall' to move it."
            exit 0
        fi

        if [ -n "${2:-}" ]; then
            bare=$(printf '%s' "$2" | sed 's/#[0-9]*$//')
            if ! list_displays | cut -f2 | grep -Fqi -- "$bare"; then
                echo "contribwall: no connected screen matches \"$2\"." >&2
                echo "Run 'contribwall displays' to see them." >&2
                exit 1
            fi
            cfg_set display "$2"
            echo "Display: $2"
            echo "Run 'contribwall' to move it."
            exit 0
        fi

        # No name given: show what is connected and ask.
        show_displays
        if [ ! -r /dev/tty ]; then
            echo "contribwall: no terminal to ask on; use 'contribwall display <name>'." >&2
            exit 1
        fi
        count=$(list_displays | wc -l | tr -d ' ')
        printf '  Which screen? [1-%s] ' "$count"
        read -r choice < /dev/tty || choice=""
        case "$choice" in
            '' | *[!0-9]*)
                echo "contribwall: not a number, nothing changed." >&2
                exit 1 ;;
        esac
        if [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
            echo "contribwall: pick a number between 1 and $count." >&2
            exit 1
        fi
        chosen=$(qualify "$(list_displays | sed -n "${choice}p" | cut -f2)" "$choice")
        cfg_set display "$chosen"
        printf '\n  Display: %s\n\n' "$chosen"
        exec "$0"
        ;;

    range)
        case "${2:-}" in
            week)                days=7 ;;
            fortnight|two-weeks) days=14 ;;
            month)               days=30 ;;
            '')
                echo "usage: contribwall range week|14|month|<1-90>" >&2
                exit 1 ;;
            *)                   days="$2" ;;
        esac
        cfg_set days "$days"
        echo "Range: $days days (on screen at the next refresh)"
        exit 0
        ;;

    ramp)
        cfg_set ramp "${2:-}"
        echo "Ramp: a busy day is ${2:-} (on screen at the next refresh)"
        exit 0
        ;;

    awake)
        uid=$(id -u)
        case "${2:-}" in
            on)
                python3 -c 'import plistlib, sys
with open(sys.argv[1], "wb") as fh:
    plistlib.dump({
        "Label": sys.argv[2],
        "ProgramArguments": ["/usr/bin/caffeinate", "-d"],
        "RunAtLoad": True,
        "KeepAlive": True,
    }, fh)' "$AGENTS/$AGENT_AWAKE.plist" "$AGENT_AWAKE"
                launchctl bootout "gui/$uid/$AGENT_AWAKE" 2>/dev/null || true
                launchctl bootstrap "gui/$uid" "$AGENTS/$AGENT_AWAKE.plist"
                echo "Screens will stay awake. This holds every display on, not just the wall."
                ;;
            off)
                launchctl bootout "gui/$uid/$AGENT_AWAKE" 2>/dev/null || true
                rm -f "$AGENTS/$AGENT_AWAKE.plist"
                echo "Screens may sleep again."
                ;;
            *)
                echo "usage: contribwall awake on|off" >&2
                exit 1 ;;
        esac
        exit 0
        ;;

    status)
        port=$(cfg port)
        display=$(cfg display)
        [ -n "$display" ] || display="auto"
        echo "Range:    $(cfg days) days"
        echo "Display:  $display"
        echo "Ramp:     busy days $(cfg ramp)"
        echo "Refresh:  every $(cfg refreshSeconds)s"
        if server_ok "$port"; then
            echo "Server:   answering on 127.0.0.1:$port"
            source=$(curl -fsS --max-time 30 "http://127.0.0.1:$port/count" 2>/dev/null \
                | python3 -c 'import json, sys
try:
    print(json.load(sys.stdin).get("source", ""))
except Exception:
    print("")' 2>/dev/null || true)
            case "${source:-}" in
                profile) echo "Reading:  your GitHub profile page" ;;
                api)     echo "Reading:  the GitHub API (profile page unreadable)" ;;
            esac
        elif launchctl print "gui/$(id -u)/$AGENT_SERVER" >/dev/null 2>&1; then
            echo "Server:   loaded but not answering on $port (see $DATA/server.log)"
        else
            echo "Server:   not loaded"
        fi
        if pgrep -f "$(browser_pattern)" >/dev/null 2>&1; then
            echo "Screen:   on"
        else
            echo "Screen:   off"
        fi
        if launchctl print "gui/$(id -u)/$AGENT_AWAKE" >/dev/null 2>&1; then
            echo "Awake:    screens held on"
        else
            echo "Awake:    screens may sleep"
        fi
        exit 0
        ;;
esac

# --- put it on screen -------------------------------------------------------
target="${1:-}"
[ "$target" = "open" ] && target=""
[ -z "$target" ] && target=$(cfg display)

port=$(cfg port)
url="http://127.0.0.1:$port/"

browser=$(find_browser) || {
    echo "contribwall: needs Chrome, Brave, Edge or Chromium in /Applications." >&2
    exit 1
}

# At login this can run before the server is listening, and the browser would
# sit on an error page forever, so wait for our own server to answer first.
tries=0
until server_ok "$port"; do
    tries=$((tries + 1))
    if [ "$tries" -ge 30 ]; then
        if curl -fsS --max-time 5 -o /dev/null "$url" 2>/dev/null; then
            echo "contribwall: something else is using port $port." >&2
            echo "Change it in ~/.config/contribwall/config.json." >&2
        else
            echo "contribwall: no server at $url after ${tries}s" >&2
            echo "try: launchctl kickstart -k gui/$(id -u)/$AGENT_SERVER" >&2
        fi
        exit 1
    fi
    sleep 1
done

geometry=$(osascript -l JavaScript "$DATA/pick-display.js" "$target")
set -- $geometry
x="$1"; y="$2"; w="$3"; h="$4"
shift 4
echo "Display: $* at ${x},${y} ${w}x${h}"

stop_window
sleep 1

# The browser remembers window bounds in its profile and will restore them over
# the flags below, so start from a clean profile and the geometry is always ours.
rm -rf "$PROFILE"

open -na "$browser" --args \
    --user-data-dir="$PROFILE" \
    --app="$url" \
    --window-position="${x},${y}" \
    --window-size="${w},${h}" \
    --start-fullscreen \
    --no-first-run --no-default-browser-check --disable-sync --noerrdialogs
